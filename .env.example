# Supabase project URL (public; safe for the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (public; safe for the browser bundle).
# RLS protects the data; never use it as a trust boundary alone.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (SERVER-ONLY). Never expose to the client.
# Used for privileged server-side operations (e.g. storage, admin trust).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical same-origin application URL used for admin/QR links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string (SERVER-ONLY). Used for operations that require
# transaction/locking control (e.g. photo submission row lock).
# Local dev: direct connection to local Supabase (port 5432).
# Production (Vercel): use Supabase Supavisor transaction-mode pooler
# (port 6543) to avoid connection exhaustion in serverless. pg 8.x is
# compatible with Supavisor (unnamed prepared statements are transaction-
# scoped); no extra client options required.
# Example: postgresql://postgres.{ref}@aws-0-{region}.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Private Supabase Storage bucket name for guest photo/audio objects.
SUPABASE_STORAGE_BUCKET=guest-media

# Photo-submission rate limiting (API Contract §3 / ADR-008).
# Fixed-window, in-memory; per client identity. Adjust for the deployment.
PHOTO_RATE_LIMIT_MAX=10
PHOTO_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum accepted photo size in bytes (server-side, authoritative).
PHOTO_MAX_SIZE_BYTES=10000000

# Voice-note submission rate limiting (API Contract §3 / ADR-008).
# Fixed-window, in-memory; per client identity. Adjust for the deployment.
VOICE_NOTE_RATE_LIMIT_MAX=10
VOICE_NOTE_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum accepted voice-note size in bytes (server-side, authoritative).
VOICE_NOTE_MAX_SIZE_BYTES=25000000

# Path to the ffprobe binary used for server-side audio inspection (ADR-006).
# If unset, defaults to the bundled @ffprobe-installer/ffprobe binary
# (platform-specific, included via outputFileTracingIncludes on Vercel).
# Override only when using a system-installed ffprobe.
# FFPROBE_PATH=ffprobe

# Session-creation rate limiting (API Contract §3 / ADR-008).
# Fixed-window, in-memory; per client identity. Adjust for the deployment.
SESSION_RATE_LIMIT_MAX=10
SESSION_RATE_LIMIT_WINDOW_SECONDS=60

# Trusted reverse proxy for rate-limit identity (ADR-008 "trusted proxy behavior").
# OFF by default: forwarded headers are never trusted, all requests share one
# coarse bucket (safe, non-spoofable). Set to 1 ONLY when behind a proxy that
# sets/sanitizes X-Forwarded-For and strips client-supplied values.
# TRUSTED_PROXY=1

# Database integration test target (optional; defaults to local Supabase).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/guestbook_test